nextflow.enable.dsl = 2

// ---- Global Docker settings ----
docker {
  enabled = true
  runOptions = '-u $(id -u):$(id -g) --platform linux/amd64'
}

// ---- Global AWS credentials ----
aws {
  accessKey = '*'
  secretKey = '**'
  region = '**'
}
// ---- Default parameters ----
params {
    outdir           = null
    input            = null
    pool_ID          = null

    // 'bam' or 'fastq' — must be set explicitly by the user
    data_type        = null

    barcodes         = "${projectDir}/assets/barcodes.384.fa"
    arrangement_toml = "${projectDir}/assets/arrangement.toml"

    length_filter    = 150
    // CUTADAPT_TRIM step 2: maximum error rate for detecting ME/P5 in a read;
    // errors allowed = floor(error_rate x matched length): 0.106 allows 2 in the 19-nt ME, 3 in the 29-nt P5
    error_rate       = 0.106
    split_n          = 15

    // Input integrity check before Dorado - OFF by default (it re-reads the
    // inputs). A single file that is split is always checked by the split
    // step, at no extra cost.
    //   check_inputs     : read the first and last input file end to end
    //   check_all_inputs : read every input file end to end
    check_inputs     = false
    check_all_inputs = false

    // DORADO_DEMUX inputs larger than this (in GB) get the "large" resources below.
    // Applies per task: a whole unsplit file, one of several input files, or one split chunk.
    large_input_gb   = 1

    // Optional fixed DORADO_DEMUX resources, e.g. --dorado_cpus 8 --dorado_mem 12g.
    // Leave null for automatic sizing by input file size (see large_input_gb).
    // When set, the value applies to EVERY DORADO_DEMUX task (incl. split chunks)
    // and the size check is skipped. Each can be set independently.
    dorado_cpus      = null
    dorado_mem       = null
}

// ---- Global process settings (shared across all profiles) ----
process {
  memory = '4 GB'
  cpus   = 1

  // DORADO_DEMUX resources:
  //   --dorado_cpus / --dorado_mem set : that value, for every task
  //   otherwise, by size of the file each task receives:
  //     <= large_input_gb : 2 CPU / 7 GB   (split chunks, normal fastq_pass files)
  //     >  large_input_gb : 4 CPU / 15 GB  (e.g. one big file run with --split_n 1)
  //   `as BigDecimal` / `as int`: CLI values arrive as strings and must be cast.
  withName:DORADO_DEMUX {
    container = 'ontresearch/dorado:sha9809639e07a927bcc0f584dadd5e59674cf59f3f'   // dorado 2.1.1+d66c17c
    cpus      = {
      params.dorado_cpus ? (params.dorado_cpus as int)
      : input_file.size() > (params.large_input_gb as BigDecimal) * 1024L**3 ? 4 : 2
    }
    memory    = {
      // --dorado_mem in GB: 32 / 32g / 32G / 32GB / '32 GB' -> normalised to '32 GB'
      params.dorado_mem
        ? params.dorado_mem.toString().trim().toUpperCase().replaceAll(/\s+/, '')
            .replaceAll(/^([0-9.]+)(GB?)?$/) { _all, n, _u -> "${n} GB" }
      : input_file.size() > (params.large_input_gb as BigDecimal) * 1024L**3 ? 15.GB : 7.GB
    }
  }
  withName:COMBINE_BARCODES        { container = 'quay.io/biocontainers/samtools:1.21--h50ea8bc_0' }
  withName:COMBINE_BARCODES_BAM    { container = 'quay.io/biocontainers/samtools:1.21--h50ea8bc_0' }
  withName:EXTRACT_HEADER          { container = 'quay.io/biocontainers/pysam:0.22.0--py39hcada746_0' ; memory = '7 GB'; cpus = 2 }
  withName:REHEADER_READS          { container = 'seqwell/python:v2.1' }
  withName:CUTADAPT_TRIM           { container = 'quay.io/biocontainers/cutadapt:5.0--py310h1fe012e_0' }
  withName:DEMUX_SUMMARIZE         { container = 'ubuntu:20.04' }
  withName:NANOSTAT                { container = 'quay.io/biocontainers/nanostat:1.6.0--pyhdfd78af_0' }
  withName:MULTIQC                 { container = 'quay.io/biocontainers/multiqc:1.25.1--pyhdfd78af_0' }
  withName:READ_LENGTH             { container = 'seqwell/python:v2.1' }
  withName:BAM_TO_FASTQ            { container = 'quay.io/biocontainers/samtools:1.21--h50ea8bc_0' }
  withName:FILTER_BAM_BY_FASTQ     { container = 'quay.io/biocontainers/samtools:1.21--h50ea8bc_0' } 
  withName:MERGE_DEMUX_BASES       { container = 'ubuntu:20.04' }
  withName:NANOSTAT_BASES          { container = 'ubuntu:20.04' }
  
  withName:CHECK_FASTQ  { container = 'quay.io/biocontainers/seqkit:2.13.0--he881be0_0'; memory = '2 GB'; cpus = 2 }
  withName:CHECK_BAM    { container = 'quay.io/biocontainers/samtools:1.21--h50ea8bc_0'; memory = '2 GB'; cpus = 2 }
  withName:SPLIT_FASTQ  { container = 'quay.io/biocontainers/seqkit:2.13.0--he881be0_0'; memory = '7 GB'; cpus = 2 }
  withName:SPLIT_BAM    { container = 'quay.io/biocontainers/samtools:1.21--h50ea8bc_0'; memory = '7 GB'; cpus = 2 }
  
}

// ---- Run reports: per-task CPU, RAM, disk I/O and time ----
// All written to <outdir>/pipeline_info/ (overwritten on each run, incl. -resume).
//   execution_report.html   : resource usage per process (CPU %, peak RAM, I/O, time) with plots
//   execution_timeline.html : when each task ran and how long it took
//   execution_trace.txt     : one row per task (tab-separated), for spreadsheets/debugging
//   pipeline_dag.html       : diagram of the workflow steps
// The pipeline also saves nextflow.log, run_summary.txt and, on failure,
// error_report.txt in the same folder (see onComplete in main.nf).
// Task metrics need `ps` (procps) inside each container; tasks whose image
// lacks it show '-' for CPU/RAM in these reports.
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir ?: '.'}/pipeline_info/execution_timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir ?: '.'}/pipeline_info/execution_report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir ?: '.'}/pipeline_info/execution_trace.txt"
    fields    = 'task_id,hash,native_id,process,tag,status,exit,attempt,submit,start,complete,duration,realtime,cpus,%cpu,memory,%mem,rss,peak_rss,vmem,peak_vmem,rchar,wchar,read_bytes,write_bytes,workdir,container'
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.outdir ?: '.'}/pipeline_info/pipeline_dag.html"
}

// ---- Profiles ----
profiles {

  // --- Local CI / GitHub Actions ---
  test {
    params {
      input     = "${projectDir}/test_data/bam_pass"
      outdir    = "${projectDir}/ci_output"
      pool_ID   = "bam_test"
      data_type = "bam"
    }
  }

  // --- Local production run ---
  docker {}

  // --- local run without -profile flag ---
  standard {}

  // --- HPC / Linux servers without Docker: Singularity or Apptainer ---
  // The Docker images in the withName blocks are pulled and converted to
  // .sif files once, into ./singularity_cache (or $NXF_SINGULARITY_CACHEDIR /
  // $NXF_APPTAINER_CACHEDIR if set), and reused by later runs.
  // The Dorado image is large (~10 GB), so its first pull can take a while.
  singularity {
    docker.enabled          = false
    singularity.enabled     = true
    singularity.autoMounts  = true
    singularity.cacheDir    = "${launchDir}/singularity_cache"
    singularity.pullTimeout = '2h'
  }
  apptainer {
    docker.enabled        = false
    apptainer.enabled     = true
    apptainer.autoMounts  = true
    apptainer.cacheDir    = "${launchDir}/singularity_cache"
    apptainer.pullTimeout = '2h'
  }

  // --- AWS Batch ---
  awsbatch {
    docker.enabled    = false
    aws.batch.cliPath = '/home/ec2-user/miniconda/bin/aws'
    process {
      executor = 'awsbatch'
      queue    = 'spot_low_priority'
    }
  }
}



manifest {
    name            = 'seqwell/ConstruX-demux'
    homePage        = 'https://github.com/seqwell/ConstruX-demux'
    description     = 'SeqWell ONT Dorado demultiplexing pipeline'
    author          = 'SeqWell'
    version         = '2.0.0'
    nextflowVersion = '>=24.04.0'
    mainScript      = 'main.nf'
}
